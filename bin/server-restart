#!/usr/bin/env php
<?php

use Websyspro\DevTools\Handlers\ServerRestartHandler;


/*
 * Update Version Composer
 */
defined( "DIR_BASE" ) || define(
  "DIR_BASE", realpath( 
    __DIR__ . "/../../../../"
  ) . DIRECTORY_SEPARATOR
);

require DIR_BASE . "vendor/autoload.php";
use Websyspro\DevTools\WatchEvents;

$watcher = new WatchEvents();
$watcher->registerHandler( handler: new ServerRestartHandler());
$watcher->listen( interval: 1 );